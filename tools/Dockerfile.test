FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv php-cli mosquitto mosquitto-clients ca-certificates curl systemd && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home loxberry
WORKDIR /plugin
COPY bin /plugin/bin
COPY tests /plugin/tests
COPY tools /plugin/tools
COPY webfrontend /plugin/webfrontend
COPY templates /plugin/templates
COPY postinstall.sh postroot.sh plugin.cfg /plugin/
COPY uninstall /plugin/uninstall
RUN python3 -m venv /testvenv && /testvenv/bin/pip install --require-hashes -r /plugin/bin/requirements.lock.txt && /testvenv/bin/pip install pytest==8.4.2
CMD ["/testvenv/bin/python", "-m", "pytest", "-q", "tests"]
